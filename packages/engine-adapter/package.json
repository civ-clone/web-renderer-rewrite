{
  "name": "@civ-clone/engine-adapter",
  "version": "0.1.0",
  "description": "Engine boundary adapter: converts live PlayerAction / unit Action objects to transport-safe protocol DTOs",
  "license": "MIT",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": "./dist/index.js",
      "types": "./dist/index.d.ts"
    }
  },
  "scripts": {
    "build": "tsc --build tsconfig.json",
    "test": "vitest run",
    "lint": "tsc --noEmit",
    "wp006:demo": "pnpm build && node dist/examples/wp006-deterministic-rng-runner.js",
    "wp009:bench": "pnpm build && node dist/examples/wp009-validation-boundary-bench.js",
    "wp010:demo": "pnpm build && node dist/examples/wp010-replay-harness-runner.js",
    "wp011:demo": "pnpm build && node dist/examples/wp011-migration-cutover-runner.js",
    "wp012:demo": "pnpm build && node dist/examples/wp012-registry-container-runner.js"
  },
  "dependencies": {
    "@civ-clone/protocol-state": "workspace:*"
  },
  "devDependencies": {
    "typescript": "^5.8.0",
    "vitest": "^3.0.0"
  }
}


